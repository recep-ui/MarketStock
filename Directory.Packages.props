<Project>
  <!-- Merkezi paket sürüm yönetimi: sürümler yalnızca burada tanımlanır -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Geçişli bağımlılıklar da burada sabitlenebilir (ör. güvenlik açığı olan eski sürümleri yükseltmek için) -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Loglama -->
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <!-- Kuyruk / zamanlayıcı -->
    <PackageVersion Include="Hangfire.AspNetCore" Version="1.8.25" />
    <PackageVersion Include="Hangfire.SqlServer" Version="1.8.25" />
    <!-- Hangfire.Core → Newtonsoft.Json >= 11.0.1 çeker; 11.0.1'de GHSA-5crp-9r3c-p9vr açığı var. Geçişli olarak yükseltilir. -->
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <!-- Veri erişimi -->
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.1.2" />
    <PackageVersion Include="Dapper" Version="2.1.89" />
    <!-- Genel CRUD (şemayı DbUp yönetir, EF migration kullanılmaz) -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.15" />
    <!-- Excel içe/dışa aktarma (MIT lisanslı; bkz. ADR-009) -->
    <PackageVersion Include="ClosedXML" Version="0.105.1" />
    <!-- Kanal adaptörleri: HTTP dayanıklılığı (Polly v8) ve loglama -->
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.15" />
    <!-- Sürümlü SQL migration'ları (bkz. docs/decisions.md ADR-004) -->
    <PackageVersion Include="dbup-sqlserver" Version="7.2.0" />
    <!-- Test -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <!-- 7.x Apache-2.0 lisanslıdır; 8.x ve sonrası ticari lisans gerektirir (bkz. docs/decisions.md ADR-005) -->
    <PackageVersion Include="FluentAssertions" Version="7.2.2" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
  </ItemGroup>
</Project>
