{
  "Database": {
    "AutoCreate": true,
    "MigrateOnStartup": true
  },
  "Hangfire": {
    "SchedulePollingIntervalSeconds": 1,
    "HeartbeatCron": "*/10 * * * * *"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Hangfire": "Information"
      }
    }
  }
}
